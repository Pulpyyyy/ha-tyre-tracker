{
  "entity": {
    "select": {
      "mounted_front": {
        "default": "mdi:car-tire-alert"
      },
      "mounted_rear": {
        "default": "mdi:car-tire-alert"
      }
    },
    "number": {
      "odometer": {
        "default": "mdi:counter"
      },
      "total": {
        "default": "mdi:counter"
      }
    },
    "sensor": {
      "current": {
        "default": "mdi:car-tire-alert"
      }
    }
  },
  "services": {
    "mount": { "service": "mdi:swap-horizontal" },
    "set_odometer": { "service": "mdi:counter" },
    "adjust": { "service": "mdi:pencil" },
    "retire": { "service": "mdi:archive-outline" },
    "restore": { "service": "mdi:archive-arrow-up-outline" },
    "unmount": { "service": "mdi:tire" },
    "rotate": { "service": "mdi:rotate-3d-variant" }
  }
}
